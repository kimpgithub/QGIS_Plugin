# 실제 값은 /srv/gis/compose/.env (chmod 600) 에 두고 commit 금지.
# 이 파일은 변수 이름·구조만 노출하는 템플릿.

# --- PostGIS ---
POSTGRES_USER=gis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gis

# --- MinIO root ---
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# --- MinIO scoped keys ---
# read-only (titiler + backend)
S3_RO_ACCESS_KEY=change-me
S3_RO_SECRET_KEY=change-me
# read-write (대전 업로드 플러그인)
S3_RW_ACCESS_KEY=change-me
S3_RW_SECRET_KEY=change-me

# --- internal endpoints ---
S3_BUCKET=gis-scan

# --- host Tailscale IP (QGIS/plugin 접속용 바인딩) ---
TS_IP=100.x.x.x

# --- 검수 웹 (발주자, /api 쿠키 인증) ---
REVIEW_PASSWORD=change-me
SESSION_SECRET=change-me

# --- 대전 플러그인 API 토큰 (Bearer) ---
PLUGIN_TOKEN=change-me

# --- 검수 웹 JWT (/web/* admin_cd 계정 로그인) ---
JWT_SECRET=change-me
JWT_EXPIRES_MIN=480
